{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velocista-sim.local/contract/v1/messages/catalog.schema.json",
  "title": "catalog",
  "description": "Robots y pistas disponibles; respuesta a list (FR-026).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "type": {
      "const": "catalog"
    },
    "robots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "robots",
    "tracks"
  ]
}
