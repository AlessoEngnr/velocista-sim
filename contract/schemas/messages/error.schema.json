{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velocista-sim.local/contract/v1/messages/error.schema.json",
  "title": "error",
  "description": "Comando inválido o que no aplica (FR-027).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "type": {
      "const": "error"
    },
    "code": {
      "$ref": "../common.schema.json#/$defs/error_code"
    },
    "message": {
      "description": "Explicación en español, legible por personas.",
      "type": "string",
      "minLength": 1
    },
    "cmd": {
      "description": "Comando que se rechaza, si es identificable.",
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "code",
    "message"
  ]
}
