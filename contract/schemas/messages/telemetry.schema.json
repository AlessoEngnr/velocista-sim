{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velocista-sim.local/contract/v1/messages/telemetry.schema.json",
  "title": "telemetry",
  "description": "Telemetría periódica a rate_hz mientras la conexión esté abierta (FR-017 a FR-020).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/envelope"
    },
    {
      "if": {
        "properties": {
          "running": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "run_id"
        ]
      },
      "else": {
        "allOf": [
          {
            "not": {
              "required": [
                "run_id"
              ]
            }
          },
          {
            "not": {
              "required": [
                "lap"
              ]
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "type": {
      "const": "telemetry"
    },
    "seq": {
      "description": "Contador por sesión desde 0.",
      "type": "integer",
      "minimum": 0
    },
    "run_id": {
      "$ref": "../common.schema.json#/$defs/run_id"
    },
    "running": {
      "type": "boolean"
    },
    "sensors": {
      "description": "Lecturas ADC crudas; la longitud y la cota dependen de hello.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      }
    },
    "line_position": {
      "description": "Milésimas de sensor.",
      "type": "integer",
      "minimum": 0
    },
    "line_lost": {
      "type": "boolean"
    },
    "error": {
      "description": "line_position − centro.",
      "type": "integer"
    },
    "control": {
      "type": "object",
      "properties": {
        "p": {
          "type": "number"
        },
        "i": {
          "type": "number"
        },
        "d": {
          "type": "number"
        },
        "out": {
          "type": "number"
        }
      },
      "required": [
        "p",
        "i",
        "d",
        "out"
      ]
    },
    "motors": {
      "type": "object",
      "properties": {
        "left": {
          "$ref": "../common.schema.json#/$defs/pwm"
        },
        "right": {
          "$ref": "../common.schema.json#/$defs/pwm"
        }
      },
      "required": [
        "left",
        "right"
      ]
    },
    "lap": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "current_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "n",
        "current_ms"
      ]
    },
    "battery_v": {
      "description": "Voltaje de batería en V.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "odometry": {
      "type": "object",
      "properties": {
        "distance_m": {
          "type": "number",
          "minimum": 0
        },
        "speed_mps": {
          "type": "number"
        },
        "heading_rad": {
          "type": "number"
        }
      },
      "minProperties": 1
    },
    "sim_truth": {
      "description": "Solo-sim: verdad del simulador.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "theta": {
          "type": "number"
        },
        "speed_mps": {
          "type": "number"
        },
        "distance_m": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "theta",
        "speed_mps",
        "distance_m"
      ]
    }
  },
  "required": [
    "seq",
    "running",
    "sensors",
    "line_position",
    "line_lost",
    "error",
    "control",
    "motors"
  ]
}
